# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# Application Settings
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production-make-it-long-and-random
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration
DATABASE_URL=postgresql://aiuser:aipassword@localhost:5432/ai_articles
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# AI/LLM Configuration
GEMINI_API_KEY=your-google-gemini-api-key-here
GEMINI_MODEL=gemini-pro
MAX_TOKENS_PER_REQUEST=4000

# Search API Configuration
GOOGLE_SEARCH_API_KEY=your-google-search-api-key-here
GOOGLE_SEARCH_ENGINE_ID=your-custom-search-engine-id-here
MAX_SEARCH_RESULTS=10

# Web Scraping Configuration
SCRAPING_TIMEOUT=30
MAX_CONCURRENT_SCRAPES=10
PLAYWRIGHT_ENABLED=true

# Article Generation Configuration
MAX_ARTICLE_LENGTH=10000
MIN_SOURCES_PER_SECTION=3
FACT_CHECK_THRESHOLD=0.8

# Monitoring & Observability
ENABLE_TRACING=true
METRICS_PORT=9090
LOG_LEVEL=INFO

# Rate Limiting
MAX_REQUESTS_PER_MINUTE=60
MAX_JOBS_PER_USER_PER_HOUR=5
